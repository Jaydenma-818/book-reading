# Firebase web config. The VITE_ prefix is what makes Vite expose these to the
# browser, which is fine: the web config is public by design.
# VITE_FIREBASE_PROJECT_ID is also the value the backend uses to verify ID
# tokens, so it lives here exactly once and the two can never drift.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Turso. No VITE_ prefix, so Vite never bundles these into the client and the
# database token stays on the server.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
