{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "import"],
  "env": { "browser": true, "es2024": true },
  "rules": {
    "no-unused-vars": "error"
  },
  "overrides": [
    {
      "files": ["server/**/*.js", "api/**/*.js"],
      "env": { "browser": false, "node": true }
    }
  ]
}
